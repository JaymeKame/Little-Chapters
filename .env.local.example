# Copy to .env.local and fill in. NOTHING here is committed.

# ── Azure Speech (pronunciation assessment) — docs/AZURE_SPEECH_SETUP.md ─────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# ── Firebase web app (client) ────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Server-only ──────────────────────────────────────────────────────────────
# Firebase Admin service-account JSON (raw or base64). Enables the fail-closed
# auth gate on the reading API routes in production.
FIREBASE_SERVICE_ACCOUNT=
# ONLY for deployments that intentionally run the reading routes without
# Firebase auth (throwaway previews). Never in prod.
SPEECH_ALLOW_UNAUTH=
# MDD decoding service, if not on the default http://127.0.0.1:8010
MDD_SERVER_URL=
# Shared bearer secret for the hosted MDD service. Use the same value in
# Cloud Run and Vercel; local MDD development works without it.
MDD_API_KEY=

# ── Twilio SMS (parent win notifications) ─────────────────────────────────────
# Get these from your Twilio console: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Stripe Payments (subscriptions) ───────────────────────────────────────────
# Get these from your Stripe dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Signing secret for POST /api/payments/webhook
STRIPE_WEBHOOK_SECRET=
# Price IDs for your subscription plans (create these in Stripe dashboard)
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
# Public app URL for Stripe redirects
NEXT_PUBLIC_APP_URL=
# Optional server-side story generation. Without it, the validated demo fallback is used.
OPENAI_API_KEY=
OPENAI_STORY_MODEL=gpt-4o-mini
# Chapter scene generation: one 2x2 storyboard is generated and cropped into four coherent scenes.
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_REVIEW_MODEL=gpt-4o-mini
# Firebase Storage bucket used for immutable chapter-scene assets.
FIREBASE_STORAGE_BUCKET=

# ── ElevenLabs TTS (recommended — the default child-facing tutor voice) ──────
# Setting this key is ALL that's needed to activate ElevenLabs: every
# speakPrompt() call attempts it by default now (2026-08-21 — this used to
# require ALSO setting NEXT_PUBLIC_VOICE_PROVIDER=elevenlabs below, which was
# a real footgun: a deployment with this key set but that separate flag
# forgotten would silently run 100% Web Speech with no error anywhere).
# When unset, POST /api/speech/model returns 503 immediately and every call
# falls back to the browser's built-in Web Speech API automatically.
# docs/VOICE_AND_PACING_AUDIT.md explains the provider comparison.
ELEVENLABS_API_KEY=
# Override the default voice (Rachel). Find IDs at https://api.elevenlabs.io/v1/voices
ELEVENLABS_VOICE_ID=
# Override the default model (eleven_turbo_v2). Options: eleven_monolingual_v1,
# eleven_multilingual_v2, eleven_turbo_v2, eleven_turbo_v2_5
ELEVENLABS_MODEL_ID=
# Escape hatch ONLY: set to "web-speech" to force the browser voice even
# when ELEVENLABS_API_KEY is configured (e.g. testing the fallback path
# itself). Leave blank in every normal deployment — ElevenLabs is already
# the default whenever the key above is set; this variable does not
# activate anything.
NEXT_PUBLIC_VOICE_PROVIDER=

# ── Optional: SpeechAce vendor comparison (scripts/assess-speechace.ts) ──────
SPEECHACE_API_KEY=
