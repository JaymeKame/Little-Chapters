# Copy to .env.local and fill in. NOTHING here is committed.

# ── Azure Speech (pronunciation assessment) — docs/AZURE_SPEECH_SETUP.md ─────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# ── Firebase web app (client) ────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Server-only ──────────────────────────────────────────────────────────────
# Firebase Admin service-account JSON (raw or base64). Enables the fail-closed
# auth gate on the reading API routes in production.
FIREBASE_SERVICE_ACCOUNT=
# ONLY for deployments that intentionally run the reading routes without
# Firebase auth (throwaway previews). Never in prod.
SPEECH_ALLOW_UNAUTH=
# MDD decoding service, if not on the default http://127.0.0.1:8010
MDD_SERVER_URL=

# ── Twilio SMS (parent win notifications) ─────────────────────────────────────
# Get these from your Twilio console: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Stripe Payments (subscriptions) ───────────────────────────────────────────
# Get these from your Stripe dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Signing secret for POST /api/payments/webhook
STRIPE_WEBHOOK_SECRET=
# Price IDs for your subscription plans (create these in Stripe dashboard)
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
# Public app URL for Stripe redirects
NEXT_PUBLIC_APP_URL=
# Optional server-side story generation. Without it, the validated demo fallback is used.
OPENAI_API_KEY=
OPENAI_STORY_MODEL=gpt-4o-mini

# ── Optional: SpeechAce vendor comparison (scripts/assess-speechace.ts) ──────
SPEECHACE_API_KEY=
